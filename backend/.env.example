# Supabase: Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of origins allowed to call the API (your Vercel URL).
# Leave empty to allow any origin.
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# LLM: any OpenAI-compatible chat completions endpoint.
# Gemini (free tier):  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash
# Groq (free tier):    LLM_BASE_URL=https://api.groq.com/openai/v1                           LLM_MODEL=llama-3.3-70b-versatile
# If LLM_API_KEY is empty, the outcome check falls back to rules and the app still works.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash
LLM_API_KEY=

PORT=8080
